//@version=6
indicator("cfd10 Student - distilled structural-turn detector", overlay=true, max_bars_back=5000)

// AUTO-GENERATED by cfd10.parity_module.export_pine -- do not edit by hand.
// Two SMALL students distilled from the cfd10 STRUCTURAL oracle (one per
// side), transcribed verbatim. A tree side is nested if/else rules; a
// gboost side is the additive margin init + learning_rate * sum(stage leaf)
// compared to logit(threshold) in RAW MARGIN space (no sigmoid is emitted,
// so the call is exact float arithmetic). Each feature is recomputed exactly
// as the cfd10 Python feature bank does (FeatureConfig defaults), itself a
// parity port of the original speculatores indicator. Internal parity
// (emitted rules == sklearn predict()) is proven by
// cfd10.parity_module.verify.verify_student_export.
// LOW  tree: depth=8, leaves=64.
// HIGH tree: depth=8, leaves=64.

// --- Parity helpers (ported from speculatores_v15_presets_gold.pine) ---------
// One stateless cumulative sum at module scope; SMA of any length is then a
// constant-time subtraction with no per-call-site state to corrupt (L87-93).
float _csum_close = ta.cum(close)

sma_at(int s, int back) =>
    float a = _csum_close[back]
    float b = _csum_close[back + s]
    na(a) or na(b) ? float(na) : (a - b) / s

// pir_of: position of `val` within its trailing `lookback` [min, max] (L68-71).
pir_of(float val, int lookback) =>
    float lo = ta.lowest(val, lookback)
    float hi = ta.highest(val, lookback)
    hi != lo ? (val - lo) / (hi - lo) : 0.5

// pir_for_scale: PIR of the close/SMA(s) ratio scanned over the last `lb` bars,
// reconstructed bar-by-bar from historical access so no stateful ta.* is called
// inside the loop (L98-113).
pir_for_scale(int s, int lb) =>
    float sma_now = sma_at(s, 0)
    float val_now = sma_now > 0 ? close / sma_now : 1.0
    float result = 0.5
    if not na(val_now)
        float lo = val_now
        float hi = val_now
        for back = 1 to lb - 1
            float sma_b = sma_at(s, back)
            float c_b = close[back]
            float r_b = sma_b > 0 ? c_b / sma_b : 1.0
            if not na(r_b)
                lo := math.min(lo, r_b)
                hi := math.max(hi, r_b)
        result := hi != lo ? (val_now - lo) / (hi - lo) : 0.5
    result

safe_log_ratio(float num, float den) =>
    math.log(math.max(num, 1e-10) / math.max(den, 1e-10))

clamp_unit(float val) =>
    math.max(-1.0, math.min(1.0, val))

// calc_har_vol: HAR / Garman-Klass volatility norm (L179-188).
calc_har_vol() =>
    float log_hl = safe_log_ratio(high, low)
    float log_co = safe_log_ratio(close, open)
    float gk_var = math.max(0.5 * log_hl * log_hl - (2.0 * math.log(2.0) - 1.0) * log_co * log_co, 1e-10)
    float gk_weekly = nz(ta.sma(gk_var, 5), gk_var)
    float gk_monthly = nz(ta.sma(gk_var, 22), gk_var)
    float har_forecast = math.max(0.36 * gk_var + 0.28 * gk_weekly + 0.28 * gk_monthly, 1e-10)
    float har_vol_ratio = math.sqrt(math.max(har_forecast, 1e-10)) / math.sqrt(math.max(gk_var, 1e-10))
    float har_vol_norm = clamp_unit((har_vol_ratio - 1.0) / 0.5)
    [har_vol_norm, har_vol_ratio]

// calc_gjr_asym: GJR-GARCH(1,1) leverage asymmetry norm (L159-177).
calc_gjr_asym() =>
    float log_ret = safe_log_ratio(close, nz(close[1], close))
    float r2 = log_ret * log_ret
    float lr_var = math.max(nz(ta.sma(r2, 252), r2), 1e-12)
    float gjr_alpha = 0.03
    float gjr_beta = 0.90
    float gjr_gamma = 0.08
    float gjr_omega = math.max(lr_var * (1.0 - gjr_alpha - gjr_beta - gjr_gamma / 2.0), 1e-12)
    var float gjr_var = na
    var float sym_var = na
    float prev_gjr = nz(gjr_var[1], lr_var)
    float prev_sym = nz(sym_var[1], lr_var)
    float prev_r2 = nz(r2[1], lr_var)
    float leverage = nz(log_ret[1], 0.0) < 0 ? 1.0 : 0.0
    gjr_var := math.max(gjr_omega + (gjr_alpha + gjr_gamma * leverage) * prev_r2 + gjr_beta * prev_gjr, 1e-12)
    sym_var := math.max(gjr_omega + (gjr_alpha + gjr_gamma * 0.5) * prev_r2 + gjr_beta * prev_sym, 1e-12)
    float gjr_asym_ratio = gjr_var / sym_var
    float gjr_asym_norm = clamp_unit((gjr_asym_ratio - 1.0) / 0.1)
    [gjr_asym_norm, gjr_asym_ratio]

// --- Feature computations (used by the student trees) -----------------------
// dist_above_sma_z_l100
float f_dist_above_sma_z_l100_sma = sma_at(100, 0)
float f_dist_above_sma_z_l100_std = ta.stdev(close, 100)
float f_dist_above_sma_z_l100_z = (f_dist_above_sma_z_l100_std > 0 and not na(f_dist_above_sma_z_l100_sma)) ? (close - f_dist_above_sma_z_l100_sma) / f_dist_above_sma_z_l100_std : 0.0
float f_dist_above_sma_z_l100 = (na(f_dist_above_sma_z_l100_sma) or na(f_dist_above_sma_z_l100_std)) ? float(na) : (math.exp(2.0 * f_dist_above_sma_z_l100_z) - 1.0) / (math.exp(2.0 * f_dist_above_sma_z_l100_z) + 1.0)
// dist_above_sma_z_l200
float f_dist_above_sma_z_l200_sma = sma_at(200, 0)
float f_dist_above_sma_z_l200_std = ta.stdev(close, 100)
float f_dist_above_sma_z_l200_z = (f_dist_above_sma_z_l200_std > 0 and not na(f_dist_above_sma_z_l200_sma)) ? (close - f_dist_above_sma_z_l200_sma) / f_dist_above_sma_z_l200_std : 0.0
float f_dist_above_sma_z_l200 = (na(f_dist_above_sma_z_l200_sma) or na(f_dist_above_sma_z_l200_std)) ? float(na) : (math.exp(2.0 * f_dist_above_sma_z_l200_z) - 1.0) / (math.exp(2.0 * f_dist_above_sma_z_l200_z) + 1.0)
// drawdown_from_high_l100
float f_drawdown_from_high_l100_hi = ta.highest(close, 100)
float f_drawdown_from_high_l100 = f_drawdown_from_high_l100_hi > 0 ? (close - f_drawdown_from_high_l100_hi) / f_drawdown_from_high_l100_hi : 0.0
// price_return_L10
float f_price_return_L10 = nz((close - close[10]) / close[10])
// har_vol
[f_har_vol_norm, f_har_vol_ratio] = calc_har_vol()
float f_har_vol = f_har_vol_norm
// pir_s20
float f_pir_s20 = pir_for_scale(20, 20)
// pir_s100
float f_pir_s100 = pir_for_scale(100, 100)
// pir_s10
float f_pir_s10 = pir_for_scale(10, 20)
// sma_slope_s20
float f_sma_slope_s20_now = sma_at(20, 0)
float f_sma_slope_s20_prev = sma_at(20, 5)
float f_sma_slope_s20 = f_sma_slope_s20_now > 0 ? nz(f_sma_slope_s20_now - f_sma_slope_s20_prev) / (5 * f_sma_slope_s20_now) * 1000.0 : 0.0
// sma_slope_s100
float f_sma_slope_s100_now = sma_at(100, 0)
float f_sma_slope_s100_prev = sma_at(100, 25)
float f_sma_slope_s100 = f_sma_slope_s100_now > 0 ? nz(f_sma_slope_s100_now - f_sma_slope_s100_prev) / (25 * f_sma_slope_s100_now) * 1000.0 : 0.0
// dist_above_sma_z_l50
float f_dist_above_sma_z_l50_sma = sma_at(50, 0)
float f_dist_above_sma_z_l50_std = ta.stdev(close, 100)
float f_dist_above_sma_z_l50_z = (f_dist_above_sma_z_l50_std > 0 and not na(f_dist_above_sma_z_l50_sma)) ? (close - f_dist_above_sma_z_l50_sma) / f_dist_above_sma_z_l50_std : 0.0
float f_dist_above_sma_z_l50 = (na(f_dist_above_sma_z_l50_sma) or na(f_dist_above_sma_z_l50_std)) ? float(na) : (math.exp(2.0 * f_dist_above_sma_z_l50_z) - 1.0) / (math.exp(2.0 * f_dist_above_sma_z_l50_z) + 1.0)
// realized_vol_pct
float f_realized_vol_pct_lr = math.log(close / close[1])
float f_realized_vol_pct_rv = ta.stdev(f_realized_vol_pct_lr, 20)
float f_realized_vol_pct = pir_of(f_realized_vol_pct_rv, 100)
// pir_s50
float f_pir_s50 = pir_for_scale(50, 50)
// drawdown_from_high_l20
float f_drawdown_from_high_l20_hi = ta.highest(close, 20)
float f_drawdown_from_high_l20 = f_drawdown_from_high_l20_hi > 0 ? (close - f_drawdown_from_high_l20_hi) / f_drawdown_from_high_l20_hi : 0.0
// vola_pos_ATR_l30
float f_vola_pos_ATR_l30_raw = ta.atr(30)
float f_vola_pos_ATR_l30 = pir_of(f_vola_pos_ATR_l30_raw, 100)
// er_abs_p40
float f_er_abs_p40_path = 0.0
for f_er_abs_p40_i = 0 to 40 - 1
    f_er_abs_p40_path += math.abs(close[f_er_abs_p40_i] - close[f_er_abs_p40_i + 1])
float f_er_abs_p40 = f_er_abs_p40_path > 0 ? math.abs(close - close[40]) / f_er_abs_p40_path : 0.0
// mom_velocity_L20
float f_mom_velocity_L20_ret = nz((close - close[20]) / close[20])
float f_mom_velocity_L20 = nz(f_mom_velocity_L20_ret - f_mom_velocity_L20_ret[1])
// vola_pos_StdDev_l30
float f_vola_pos_StdDev_l30_raw = ta.stdev(close, 30)
float f_vola_pos_StdDev_l30 = pir_of(f_vola_pos_StdDev_l30_raw, 100)
// mom_divergence_L40
float f_mom_divergence_L40_pr = nz((close - close[40]) / close[40])
float f_mom_divergence_L40_vr = nz((volume - volume[40]) / math.max(nz(volume[40]), 1))
float f_mom_divergence_L40 = f_mom_divergence_L40_pr * f_mom_divergence_L40_vr
// linreg_slope_s50
float f_linreg_slope_s50_b = ta.linreg(close, 50, 0) - ta.linreg(close, 50, 1)
float f_linreg_slope_s50_sma = sma_at(50, 0)
float f_linreg_slope_s50 = f_linreg_slope_s50_sma > 0 ? f_linreg_slope_s50_b / f_linreg_slope_s50_sma * 1000.0 : 0.0
// er_dir_p10
float f_er_dir_p10_path = 0.0
for f_er_dir_p10_i = 0 to 10 - 1
    f_er_dir_p10_path += math.abs(close[f_er_dir_p10_i] - close[f_er_dir_p10_i + 1])
float f_er_dir_p10 = f_er_dir_p10_path > 0 ? (close - close[10]) / f_er_dir_p10_path : 0.0
// mom_velocity_L10
float f_mom_velocity_L10_ret = nz((close - close[10]) / close[10])
float f_mom_velocity_L10 = nz(f_mom_velocity_L10_ret - f_mom_velocity_L10_ret[1])
// er_dir_p40
float f_er_dir_p40_path = 0.0
for f_er_dir_p40_i = 0 to 40 - 1
    f_er_dir_p40_path += math.abs(close[f_er_dir_p40_i] - close[f_er_dir_p40_i + 1])
float f_er_dir_p40 = f_er_dir_p40_path > 0 ? (close - close[40]) / f_er_dir_p40_path : 0.0
// linreg_slope_s20
float f_linreg_slope_s20_b = ta.linreg(close, 20, 0) - ta.linreg(close, 20, 1)
float f_linreg_slope_s20_sma = sma_at(20, 0)
float f_linreg_slope_s20 = f_linreg_slope_s20_sma > 0 ? f_linreg_slope_s20_b / f_linreg_slope_s20_sma * 1000.0 : 0.0
// linreg_slope_s100
float f_linreg_slope_s100_b = ta.linreg(close, 100, 0) - ta.linreg(close, 100, 1)
float f_linreg_slope_s100_sma = sma_at(100, 0)
float f_linreg_slope_s100 = f_linreg_slope_s100_sma > 0 ? f_linreg_slope_s100_b / f_linreg_slope_s100_sma * 1000.0 : 0.0
// pir_s5
float f_pir_s5 = pir_for_scale(5, 20)
// sma_slope_s50
float f_sma_slope_s50_now = sma_at(50, 0)
float f_sma_slope_s50_prev = sma_at(50, 13)
float f_sma_slope_s50 = f_sma_slope_s50_now > 0 ? nz(f_sma_slope_s50_now - f_sma_slope_s50_prev) / (13 * f_sma_slope_s50_now) * 1000.0 : 0.0
// price_return_L20
float f_price_return_L20 = nz((close - close[20]) / close[20])
// up_streak_norm
var int f_up_streak_norm_streak = 0
f_up_streak_norm_streak := close > close[1] ? f_up_streak_norm_streak + 1 : 0
float f_up_streak_norm = math.min(f_up_streak_norm_streak, 5) / 5.0
// price_return_L40
float f_price_return_L40 = nz((close - close[40]) / close[40])
// agree_high
int f_agree_high_count = 0
int f_agree_high_valid = 0
float f_agree_high_p3 = pir_for_scale(3, 20)
if not na(f_agree_high_p3)
    f_agree_high_valid += 1
    if f_agree_high_p3 > 0.8
        f_agree_high_count += 1
float f_agree_high_p16 = pir_for_scale(16, 20)
if not na(f_agree_high_p16)
    f_agree_high_valid += 1
    if f_agree_high_p16 > 0.8
        f_agree_high_count += 1
float f_agree_high_p29 = pir_for_scale(29, 29)
if not na(f_agree_high_p29)
    f_agree_high_valid += 1
    if f_agree_high_p29 > 0.8
        f_agree_high_count += 1
float f_agree_high_p42 = pir_for_scale(42, 42)
if not na(f_agree_high_p42)
    f_agree_high_valid += 1
    if f_agree_high_p42 > 0.8
        f_agree_high_count += 1
float f_agree_high_p55 = pir_for_scale(55, 55)
if not na(f_agree_high_p55)
    f_agree_high_valid += 1
    if f_agree_high_p55 > 0.8
        f_agree_high_count += 1
float f_agree_high_p68 = pir_for_scale(68, 68)
if not na(f_agree_high_p68)
    f_agree_high_valid += 1
    if f_agree_high_p68 > 0.8
        f_agree_high_count += 1
float f_agree_high_p81 = pir_for_scale(81, 81)
if not na(f_agree_high_p81)
    f_agree_high_valid += 1
    if f_agree_high_p81 > 0.8
        f_agree_high_count += 1
float f_agree_high_p94 = pir_for_scale(94, 94)
if not na(f_agree_high_p94)
    f_agree_high_valid += 1
    if f_agree_high_p94 > 0.8
        f_agree_high_count += 1
float f_agree_high_p107 = pir_for_scale(107, 107)
if not na(f_agree_high_p107)
    f_agree_high_valid += 1
    if f_agree_high_p107 > 0.8
        f_agree_high_count += 1
float f_agree_high_p120 = pir_for_scale(120, 120)
if not na(f_agree_high_p120)
    f_agree_high_valid += 1
    if f_agree_high_p120 > 0.8
        f_agree_high_count += 1
float f_agree_high = f_agree_high_valid >= 10 ? f_agree_high_count / 10.0 : float(na)
// vola_pos_Intraday_l14
float f_vola_pos_Intraday_l14_raw = ta.sma(close > 0 ? (high - low) / close : 0.0, 14)
float f_vola_pos_Intraday_l14 = pir_of(f_vola_pos_Intraday_l14_raw, 100)
// gjr_asym
[f_gjr_asym_norm, f_gjr_asym_ratio] = calc_gjr_asym()
float f_gjr_asym = f_gjr_asym_norm
// vola_pos_StdDev_l14
float f_vola_pos_StdDev_l14_raw = ta.stdev(close, 14)
float f_vola_pos_StdDev_l14 = pir_of(f_vola_pos_StdDev_l14_raw, 100)
// mom_divergence_L20
float f_mom_divergence_L20_pr = nz((close - close[20]) / close[20])
float f_mom_divergence_L20_vr = nz((volume - volume[20]) / math.max(nz(volume[20]), 1))
float f_mom_divergence_L20 = f_mom_divergence_L20_pr * f_mom_divergence_L20_vr
// mom_velocity_L40
float f_mom_velocity_L40_ret = nz((close - close[40]) / close[40])
float f_mom_velocity_L40 = nz(f_mom_velocity_L40_ret - f_mom_velocity_L40_ret[1])
// er_abs_p20
float f_er_abs_p20_path = 0.0
for f_er_abs_p20_i = 0 to 20 - 1
    f_er_abs_p20_path += math.abs(close[f_er_abs_p20_i] - close[f_er_abs_p20_i + 1])
float f_er_abs_p20 = f_er_abs_p20_path > 0 ? math.abs(close - close[20]) / f_er_abs_p20_path : 0.0
// er_dir_p20
float f_er_dir_p20_path = 0.0
for f_er_dir_p20_i = 0 to 20 - 1
    f_er_dir_p20_path += math.abs(close[f_er_dir_p20_i] - close[f_er_dir_p20_i + 1])
float f_er_dir_p20 = f_er_dir_p20_path > 0 ? (close - close[20]) / f_er_dir_p20_path : 0.0
// vola_pos_Intraday_l30
float f_vola_pos_Intraday_l30_raw = ta.sma(close > 0 ? (high - low) / close : 0.0, 30)
float f_vola_pos_Intraday_l30 = pir_of(f_vola_pos_Intraday_l30_raw, 100)

// --- LOW-pivot rule set (bottom turns) --------------------------------------
bool student_low = false
if f_dist_above_sma_z_l100 <= -0.9107377529144287
    if f_dist_above_sma_z_l200 <= -0.9433416128158569
        if f_price_return_L10 <= -0.033533623442053795
            if f_har_vol <= -0.03365311771631241
                if f_pir_s10 <= 0.7717548906803131
                    if f_drawdown_from_high_l100 <= -0.12792442739009857
                        if f_har_vol <= -0.3888976275920868
                            if f_linreg_slope_s20 <= -2.3001612424850464
                                student_low := true
                            else
                                student_low := true
                        else
                            if f_sma_slope_s50 <= -1.775816261768341
                                student_low := true
                            else
                                student_low := true
                    else
                        if f_har_vol <= -0.48183707892894745
                            student_low := true
                        else
                            if f_dist_above_sma_z_l200 <= -0.9952886402606964
                                student_low := true
                            else
                                student_low := student_low
                else
                    student_low := student_low
            else
                if f_pir_s100 <= 0.07915246114134789
                    if f_pir_s20 <= 0.14253190904855728
                        if f_linreg_slope_s50 <= -1.119993269443512
                            if f_linreg_slope_s100 <= -1.6090843081474304
                                student_low := true
                            else
                                student_low := true
                        else
                            student_low := true
                    else
                        if f_er_dir_p10 <= -0.46921926736831665
                            if f_pir_s100 <= 0.029923764057457447
                                student_low := true
                            else
                                student_low := student_low
                        else
                            if f_dist_above_sma_z_l200 <= -0.9873577654361725
                                student_low := true
                            else
                                student_low := true
                else
                    if f_pir_s10 <= 0.23287948966026306
                        if f_drawdown_from_high_l20 <= -0.08227567002177238
                            student_low := true
                        else
                            student_low := student_low
                    else
                        if f_vola_pos_ATR_l30 <= 0.23620253801345825
                            if f_linreg_slope_s20 <= -6.2838945388793945
                                student_low := student_low
                            else
                                student_low := true
                        else
                            student_low := student_low
        else
            if f_har_vol <= -0.366525337100029
                if f_pir_s100 <= 0.043400879949331284
                    student_low := student_low
                else
                    if f_mom_velocity_L10 <= 0.0014570632192771882
                        student_low := true
                    else
                        student_low := true
            else
                if f_drawdown_from_high_l100 <= -0.1043897308409214
                    if f_pir_s20 <= 0.4504290819168091
                        if f_realized_vol_pct <= 0.8586975038051605
                            if f_dist_above_sma_z_l50 <= -0.8717894852161407
                                student_low := true
                            else
                                student_low := true
                        else
                            student_low := student_low
                    else
                        if f_pir_s50 <= 0.19777743518352509
                            student_low := true
                        else
                            if f_vola_pos_ATR_l30 <= 0.05762782506644726
                                student_low := true
                            else
                                student_low := student_low
                else
                    if f_dist_above_sma_z_l200 <= -0.9993810653686523
                        student_low := student_low
                    else
                        if f_er_dir_p40 <= -0.3337525576353073
                            if f_pir_s5 <= 0.3830084949731827
                                student_low := true
                            else
                                student_low := student_low
                        else
                            student_low := student_low
    else
        if f_har_vol <= -0.3292284607887268
            if f_sma_slope_s100 <= -0.26532796025276184
                if f_vola_pos_ATR_l30 <= 0.5744370222091675
                    student_low := true
                else
                    student_low := true
            else
                if f_price_return_L10 <= -0.07696104422211647
                    student_low := true
                else
                    student_low := student_low
        else
            if f_dist_above_sma_z_l50 <= -0.6472615897655487
                if f_mom_divergence_L40 <= -0.3233739584684372
                    student_low := student_low
                else
                    if f_mom_velocity_L20 <= 0.03668649308383465
                        if f_pir_s50 <= 0.5537275671958923
