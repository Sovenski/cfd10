//@version=6
indicator("cfd10 Student - distilled structural-turn detector", overlay=true, max_bars_back=5000)

// AUTO-GENERATED by cfd10.parity_module.export_pine -- do not edit by hand.
// Two shallow decision trees distilled from the cfd10 STRUCTURAL oracle
// (one per side), transcribed verbatim as nested if/else rule sets. Each
// feature is recomputed exactly as the cfd10 Python feature bank does
// (FeatureConfig defaults), which is itself a parity port of the original
// speculatores indicator. Internal parity (emitted rules == sklearn tree)
// is proven by cfd10.parity_module.verify.verify_student_export.
// LOW  tree: depth=4, leaves=14.
// HIGH tree: depth=4, leaves=16.

// --- Parity helpers (ported from speculatores_v15_presets_gold.pine) ---------
// One stateless cumulative sum at module scope; SMA of any length is then a
// constant-time subtraction with no per-call-site state to corrupt (L87-93).
float _csum_close = ta.cum(close)

sma_at(int s, int back) =>
    float a = _csum_close[back]
    float b = _csum_close[back + s]
    na(a) or na(b) ? float(na) : (a - b) / s

// pir_of: position of `val` within its trailing `lookback` [min, max] (L68-71).
pir_of(float val, int lookback) =>
    float lo = ta.lowest(val, lookback)
    float hi = ta.highest(val, lookback)
    hi != lo ? (val - lo) / (hi - lo) : 0.5

// pir_for_scale: PIR of the close/SMA(s) ratio scanned over the last `lb` bars,
// reconstructed bar-by-bar from historical access so no stateful ta.* is called
// inside the loop (L98-113).
pir_for_scale(int s, int lb) =>
    float sma_now = sma_at(s, 0)
    float val_now = sma_now > 0 ? close / sma_now : 1.0
    float result = 0.5
    if not na(val_now)
        float lo = val_now
        float hi = val_now
        for back = 1 to lb - 1
            float sma_b = sma_at(s, back)
            float c_b = close[back]
            float r_b = sma_b > 0 ? c_b / sma_b : 1.0
            if not na(r_b)
                lo := math.min(lo, r_b)
                hi := math.max(hi, r_b)
        result := hi != lo ? (val_now - lo) / (hi - lo) : 0.5
    result

safe_log_ratio(float num, float den) =>
    math.log(math.max(num, 1e-10) / math.max(den, 1e-10))

clamp_unit(float val) =>
    math.max(-1.0, math.min(1.0, val))

// calc_har_vol: HAR / Garman-Klass volatility norm (L179-188).
calc_har_vol() =>
    float log_hl = safe_log_ratio(high, low)
    float log_co = safe_log_ratio(close, open)
    float gk_var = math.max(0.5 * log_hl * log_hl - (2.0 * math.log(2.0) - 1.0) * log_co * log_co, 1e-10)
    float gk_weekly = nz(ta.sma(gk_var, 5), gk_var)
    float gk_monthly = nz(ta.sma(gk_var, 22), gk_var)
    float har_forecast = math.max(0.36 * gk_var + 0.28 * gk_weekly + 0.28 * gk_monthly, 1e-10)
    float har_vol_ratio = math.sqrt(math.max(har_forecast, 1e-10)) / math.sqrt(math.max(gk_var, 1e-10))
    float har_vol_norm = clamp_unit((har_vol_ratio - 1.0) / 0.5)
    [har_vol_norm, har_vol_ratio]

// --- Feature computations (used by the student trees) -----------------------
// price_return_L40
float f_price_return_L40 = nz((close - close[40]) / close[40])
// er_dir_p10
float f_er_dir_p10_path = 0.0
for f_er_dir_p10_i = 0 to 10 - 1
    f_er_dir_p10_path += math.abs(close[f_er_dir_p10_i] - close[f_er_dir_p10_i + 1])
float f_er_dir_p10 = f_er_dir_p10_path > 0 ? (close - close[10]) / f_er_dir_p10_path : 0.0
// sma_slope_s100
float f_sma_slope_s100_now = sma_at(100, 0)
float f_sma_slope_s100_prev = sma_at(100, 25)
float f_sma_slope_s100 = f_sma_slope_s100_now > 0 ? nz(f_sma_slope_s100_now - f_sma_slope_s100_prev) / (25 * f_sma_slope_s100_now) * 1000.0 : 0.0
// har_vol
[f_har_vol_norm, f_har_vol_ratio] = calc_har_vol()
float f_har_vol = f_har_vol_norm
// price_return_L20
float f_price_return_L20 = nz((close - close[20]) / close[20])
// vola_pos_ATR_l14
float f_vola_pos_ATR_l14_raw = ta.atr(14)
float f_vola_pos_ATR_l14 = pir_of(f_vola_pos_ATR_l14_raw, 100)
// linreg_slope_s50
float f_linreg_slope_s50_b = ta.linreg(close, 50, 0) - ta.linreg(close, 50, 1)
float f_linreg_slope_s50_sma = sma_at(50, 0)
float f_linreg_slope_s50 = f_linreg_slope_s50_sma > 0 ? f_linreg_slope_s50_b / f_linreg_slope_s50_sma * 1000.0 : 0.0
// linreg_slope_s100
float f_linreg_slope_s100_b = ta.linreg(close, 100, 0) - ta.linreg(close, 100, 1)
float f_linreg_slope_s100_sma = sma_at(100, 0)
float f_linreg_slope_s100 = f_linreg_slope_s100_sma > 0 ? f_linreg_slope_s100_b / f_linreg_slope_s100_sma * 1000.0 : 0.0
// price_return_L10
float f_price_return_L10 = nz((close - close[10]) / close[10])
// mom_divergence_L10
float f_mom_divergence_L10_pr = nz((close - close[10]) / close[10])
float f_mom_divergence_L10_vr = nz((volume - volume[10]) / math.max(nz(volume[10]), 1))
float f_mom_divergence_L10 = f_mom_divergence_L10_pr * f_mom_divergence_L10_vr
// er_dir_p40
float f_er_dir_p40_path = 0.0
for f_er_dir_p40_i = 0 to 40 - 1
    f_er_dir_p40_path += math.abs(close[f_er_dir_p40_i] - close[f_er_dir_p40_i + 1])
float f_er_dir_p40 = f_er_dir_p40_path > 0 ? (close - close[40]) / f_er_dir_p40_path : 0.0
// mom_divergence_L20
float f_mom_divergence_L20_pr = nz((close - close[20]) / close[20])
float f_mom_divergence_L20_vr = nz((volume - volume[20]) / math.max(nz(volume[20]), 1))
float f_mom_divergence_L20 = f_mom_divergence_L20_pr * f_mom_divergence_L20_vr
// er_abs_p20
float f_er_abs_p20_path = 0.0
for f_er_abs_p20_i = 0 to 20 - 1
    f_er_abs_p20_path += math.abs(close[f_er_abs_p20_i] - close[f_er_abs_p20_i + 1])
float f_er_abs_p20 = f_er_abs_p20_path > 0 ? math.abs(close - close[20]) / f_er_abs_p20_path : 0.0
// vola_pos_StdDev_l30
float f_vola_pos_StdDev_l30_raw = ta.stdev(close, 30)
float f_vola_pos_StdDev_l30 = pir_of(f_vola_pos_StdDev_l30_raw, 100)
// pir_s100
float f_pir_s100 = pir_for_scale(100, 100)

// --- LOW-pivot rule set (bottom turns) --------------------------------------
bool student_low = false
if f_price_return_L40 <= -0.030072979629039764
    if f_er_dir_p10 <= 0.019607258960604668
        if f_sma_slope_s100 <= 0.5312185883522034
            if f_price_return_L20 <= -0.023792576976120472
                student_low := true
            else
                student_low := true
        else
            if f_vola_pos_ATR_l14 <= 0.965783566236496
                student_low := student_low
            else
                student_low := true
    else
        if f_har_vol <= -0.3849361687898636
            if f_sma_slope_s100 <= -0.6214631199836731
                student_low := true
            else
                student_low := student_low
        else
            student_low := student_low
else
    if f_price_return_L40 <= -0.005672586848959327
        if f_har_vol <= 7.167288458731491e-06
            if f_linreg_slope_s100 <= -0.09947314858436584
                student_low := true
            else
                student_low := student_low
        else
            student_low := student_low
    else
        if f_linreg_slope_s50 <= -1.723492443561554
            if f_price_return_L10 <= -0.061648253351449966
                student_low := true
            else
                student_low := student_low
        else
            if f_mom_divergence_L10 <= -0.1700323298573494
                student_low := true
            else
                student_low := student_low

// --- HIGH-pivot rule set (top turns) ----------------------------------------
bool student_high = false
if f_price_return_L20 <= 0.0181525070220232
    if f_er_dir_p40 <= 0.07890509068965912
        if f_har_vol <= -0.4256203919649124
            if f_sma_slope_s100 <= 0.9126161634922028
                student_high := student_high
            else
                student_high := true
        else
            if f_pir_s100 <= 1.225263872584037e-06
                student_high := student_high
            else
                student_high := student_high
    else
        if f_har_vol <= -0.3194006234407425
            if f_er_abs_p20 <= 0.10771208629012108
                student_high := true
            else
                student_high := student_high
        else
            if f_price_return_L10 <= 0.010411214083433151
                student_high := student_high
            else
                student_high := student_high
else
    if f_linreg_slope_s100 <= -0.196149580180645
        if f_mom_divergence_L20 <= 0.07087330520153046
            if f_vola_pos_StdDev_l30 <= 0.9999841451644897
                student_high := student_high
            else
                student_high := student_high
        else
            if f_linreg_slope_s100 <= -0.6029908955097198
                student_high := student_high
            else
                student_high := true
    else
        if f_er_dir_p10 <= -0.09002094715833664
            if f_har_vol <= -0.3982046991586685
                student_high := true
            else
                student_high := student_high
        else
            if f_er_dir_p40 <= -0.007251962088048458
                student_high := student_high
            else
                student_high := true

// --- Markers (mirror the original indicator's pivot triangles) --------------
plotshape(student_high and not student_high[1], title="Student High", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal)
plotshape(student_low and not student_low[1], title="Student Low", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal)

color bg = na
if student_high
    bg := color.new(color.red, 80)
else if student_low
    bg := color.new(color.green, 80)
bgcolor(bg)

alertcondition(student_high and not student_high[1], "Student High", "cfd10 student: HIGH pivot")
alertcondition(student_low and not student_low[1], "Student Low", "cfd10 student: LOW pivot")
