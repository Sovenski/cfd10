//@version=6
indicator("Speculatores V15 Presets - Per-Side Regimes (edge voting)", overlay=true, max_bars_back=5000)

// Preset architecture:
// - Gold 1D Current: exact final 500-run HIGH/LOW winners from the optimizer logs
// - DAX 1M Latest: dedicated paste target for the latest DAX 1M optimizer snapshot
// - SPX 1D 2026-03-29 18:35 Trial 1225: diagnostic LOW-side trial from the live SPX daily run
// - SPX 1D 2026-04-05 Parity High+Low: diagnostic preset to test both sides at once
// - SPX 1D 2026-04-05 Heuristic Structural: manually inferred structural-turn candidate
// - SPX 1D 2026-04-05 20:59 Salvaged Best: best HIGH/LOW recovered from corrupted overnight run
// Gold 1D Current winners:
// - HIGH: trial 292, score 0.33373417096497426
// - LOW:  trial 465, score 0.40781242900926357
// DAX 1M Latest staging values:
// - HIGH: trial 226, score 2.484987
// - LOW:  trial 292, score 2.866245
// SPX 1D 2026-03-29 18:35 Trial 1225:
// - LOW: trial 1225, score 0.000000
// - HIGH side intentionally left on Gold 1D Current for comparison
// SPX 1D 2026-04-05 Parity High+Low:
// - HIGH: trial 4837, score 0.037415
// - LOW: trial 1225, score 0.000000
// SPX 1D 2026-04-05 Heuristic Structural:
// - not optimizer-derived
// - based on the parity-proven SPX high/low pair, but tightened for cleaner structural turns
// SPX 1D 2026-05-23 Path A 5k:
// - HIGH: trial 425, score 0.187983 (5k-trial run, new Path A scorer, 14 bar-based folds)
// - LOW: trial 305, score 0.255162
// - Stopped early at ~341/225 completed trials per side; partial-run best

// SPX 1D 2026-05-18 21:51 Path A:
// - HIGH: trial 228, score 0.019842 (new Path A scorer on 5 legacy folds)
// - LOW: trial 102, score 0.017296
// - NOTE: stability probe flagged both as 'likely outlier' — params may be fragile

// SPX 1D 2026-04-05 20:59 Salvaged Best:
// - HIGH: trial 4101, score 0.331818
// - LOW: trial 2516, score 0.126710

// SPX 1D 2026-05-23 V15 Run 2 (Scorer v3 winners):
//   HIGH: trial 229, score 0.0679 (deflated 0.0667). use_edge_voting=False.
//         er_directional + trend-only vote. No other gates.
//         CAUTION: holdout IS=0.065 -> OOS=0.032 (~50% degradation on 2004-2026).
//   LOW:  trial 130, score 0.1441 (deflated 0.1415). use_edge_voting=True, K=48.
//         er_dir + trend + mom + mom_vel + vola consensus. GJR/HAR off.
//         Holdout IS=0.189 ~= OOS=0.194 -- generalizes cleanly to modern regime.
//   Scorer v3 = Hungarian matching + bootstrap-CI LCB + stable reference scale N=50.

// SPX 1D 2026-05-24 V15 Run 3 (Scorer v4 winners):
//   HIGH: trial 167, score 0.0656 (deflated 0.0635). use_edge_voting=True, K=28.
//         trend + volume + mom_vel + vola consensus.
//         CAUTION: holdout IS=0.025 -> OOS=0.000. HIGH is the noise floor on SPX 1D
//         in this feature space. Keep on chart for comparison, not signal.
//   LOW:  trial 169, score 0.0708 (deflated 0.0667). use_edge_voting=False.
//         trend + volume + mom_vel + er_gate consensus. ATR vola, Trend mom_vel mode.
//         Holdout IS=0.029 -> OOS=0.089 (OOS 3x better than IS).
//         Stability local_mean/best = 99.7%. This is the v4 keeper.
//   Scorer v4 oracle = structural-nest [50, 100, 200], catches 7/7 famous SPX lows.

string GRP_PRESET = "Preset"
string preset = input.string("Gold 1D Current", "Config Preset", options=["Gold 1D Current", "DAX 1M Latest", "SPX 1D 2026-03-29 18:35 Trial 1225", "SPX 1D 2026-04-05 Parity High+Low", "SPX 1D 2026-04-05 Heuristic Structural", "SPX 1D 2026-04-05 20:59 Salvaged Best", "SPX 1D 2026-05-18 21:51 Path A", "SPX 1D 2026-05-23 Path A 5k", "SPX 1D 2026-05-23 Path A 5k Edge", "SPX 1D 2026-05-23 V15 Run 1", "SPX 1D 2026-05-23 V15 Run 1 Selective", "SPX 1D 2026-05-23 V15 Run 2", "SPX 1D 2026-05-24 V15 Run 3", "Legacy V11 Gold"], group=GRP_PRESET)

string GRP_DI = "Display"
show_bg = input.bool(true, "Show Background Shading", group=GRP_DI)
show_baseline = input.bool(true, "Show Baseline Pivots", group=GRP_DI)
show_panel = input.bool(true, "Show Preset Panel", group=GRP_DI)

pir_of(float val, int lookback) =>
    float lo = ta.lowest(val, lookback)
    float hi = ta.highest(val, lookback)
    hi != lo ? (val - lo) / (hi - lo) : 0.5

// === PARITY SHIM ============================================================
// Pine's stateful ta.* built-ins (ta.sma, ta.lowest, ta.highest) all share ONE
// internal history buffer per written call site. Putting them inside a loop
// with a variable length silently corrupts the buffer — for each scale_step we
// stomp the previous scale's state. That produced a 0.14-mean / 0.9-max
// divergence vs Python and a 2x signal-count gap on Path A 5k.
//
// Fix: never call a stateful ta.* inside the variable-s loop. Use ta.cum(close)
// (one stateless cumulative sum at module scope) to compute SMA of any length
// as a constant-time subtraction, and reconstruct ratio history bar-by-bar
// inside the loop with plain arithmetic on historical access. No state is
// shared across scales because we don't touch any stateful built-in inside the
// loop body.
// ============================================================================
float _csum_close = ta.cum(close)

// SMA at scale s, evaluated at bar (current - back). Pure arithmetic, no state.
sma_at(int s, int back) =>
    float a = _csum_close[back]
    float b = _csum_close[back + s]
    na(a) or na(b) ? float(na) : (a - b) / s

// PIR of the close/sma_s ratio series, scanned over the last `lb` bars.
// Uses only historical access — no ta.lowest/ta.highest — so it has no
// per-call-site state to corrupt across scales.
pir_for_scale(int s, int lb) =>
    float sma_now = sma_at(s, 0)
    float val_now = sma_now > 0 ? close / sma_now : 1.0
    float result = 0.5
    if not na(val_now)
        float lo = val_now
        float hi = val_now
        for back = 1 to lb - 1
            float sma_b = sma_at(s, back)
            float c_b = close[back]
            float r_b = sma_b > 0 ? c_b / sma_b : 1.0
            if not na(r_b)
                lo := math.min(lo, r_b)
                hi := math.max(hi, r_b)
        result := hi != lo ? (val_now - lo) / (hi - lo) : 0.5
    result

calc_agreement(int scale_start, int scale_end, int scale_step, float pct_extreme) =>
    int n_scales = 0
    int scales_high = 0
    int scales_low = 0
    for s = scale_start to scale_end by scale_step
        int lb = math.max(s, 20)
        float pir_s = pir_for_scale(s, lb)
        scales_high += pir_s > pct_extreme ? 1 : 0
        scales_low += pir_s < (1.0 - pct_extreme) ? 1 : 0
        n_scales += 1
    float n_scales_f = math.max(n_scales, 1)
    [scales_high, scales_low, n_scales, scales_high / n_scales_f, scales_low / n_scales_f]

low_scale_flag(int s, float pct_extreme) =>
    float sma_s = ta.sma(close, s)
    float ratio_s = sma_s > 0 ? close / sma_s : 1.0
    int lb = math.max(s, 20)
    float pir_s = pir_of(ratio_s, lb)
    pir_s < (1.0 - pct_extreme) ? 1.0 : 0.0

high_scale_flag(int s, float pct_extreme) =>
    float sma_s = ta.sma(close, s)
    float ratio_s = sma_s > 0 ? close / sma_s : 1.0
    int lb = math.max(s, 20)
    float pir_s = pir_of(ratio_s, lb)
    pir_s > pct_extreme ? 1.0 : 0.0

calc_pivot_drift(array<float> pivots, int lookback) =>
    float out = na
    int min_pivots = math.max(lookback, 2)
    int sz = array.size(pivots)
    if sz >= min_pivots
        float start_val = array.get(pivots, sz - min_pivots)
        float end_val = array.get(pivots, sz - 1)
        int pivot_count = min_pivots - 1
        out := ((end_val - start_val) / math.max(math.abs(start_val), 1e-9)) / pivot_count
    out

safe_log_ratio(float num, float den) =>
    math.log(math.max(num, 1e-10) / math.max(den, 1e-10))

clamp_unit(float val) =>
    math.max(-1.0, math.min(1.0, val))

calc_gjr_asym() =>
    float log_ret = safe_log_ratio(close, nz(close[1], close))
    float r2 = log_ret * log_ret
    float lr_var = math.max(nz(ta.sma(r2, 252), r2), 1e-12)
    float gjr_alpha = 0.03
    float gjr_beta = 0.90
    float gjr_gamma = 0.08
    float gjr_omega = math.max(lr_var * (1.0 - gjr_alpha - gjr_beta - gjr_gamma / 2.0), 1e-12)
    var float gjr_var = na
    var float sym_var = na
    float prev_gjr = nz(gjr_var[1], lr_var)
    float prev_sym = nz(sym_var[1], lr_var)
    float prev_r2 = nz(r2[1], lr_var)
    float leverage = nz(log_ret[1], 0.0) < 0 ? 1.0 : 0.0
    gjr_var := math.max(gjr_omega + (gjr_alpha + gjr_gamma * leverage) * prev_r2 + gjr_beta * prev_gjr, 1e-12)
    sym_var := math.max(gjr_omega + (gjr_alpha + gjr_gamma * 0.5) * prev_r2 + gjr_beta * prev_sym, 1e-12)
    float gjr_asym_ratio = gjr_var / sym_var
    float gjr_asym_norm = clamp_unit((gjr_asym_ratio - 1.0) / 0.1)
    [gjr_asym_norm, gjr_asym_ratio]

calc_har_vol() =>
    float log_hl = safe_log_ratio(high, low)
    float log_co = safe_log_ratio(close, open)
    float gk_var = math.max(0.5 * log_hl * log_hl - (2.0 * math.log(2.0) - 1.0) * log_co * log_co, 1e-10)
    float gk_weekly = nz(ta.sma(gk_var, 5), gk_var)
    float gk_monthly = nz(ta.sma(gk_var, 22), gk_var)
    float har_forecast = math.max(0.36 * gk_var + 0.28 * gk_weekly + 0.28 * gk_monthly, 1e-10)
    float har_vol_ratio = math.sqrt(math.max(har_forecast, 1e-10)) / math.sqrt(math.max(gk_var, 1e-10))
    float har_vol_norm = clamp_unit((har_vol_ratio - 1.0) / 0.5)
    [har_vol_norm, har_vol_ratio]

